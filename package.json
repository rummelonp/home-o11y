{
  "name": "home-o11y",
  "version": "0.0.0",
  "private": true,
  "description": "家のセンサーの値を Mackerel に投稿し、Cloudflare D1 に貯める Worker",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22 <25"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "lint": "biome check .",
    "format": "biome check --write .",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "typecheck": "wrangler types --include-runtime=false --strict-vars=false --check && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/deploy.mjs migrate",
    "deploy:remote": "node scripts/deploy.mjs deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
