# デプロイ先ごとの値。deploy.env にコピーして書き換える（deploy.env はコミットしない）。

# `wrangler d1 create home-o11y --update-config=false` が表示する database_id（UUID）
D1_DATABASE_ID=

# 値を読む SwitchBot のデバイス。<deviceId>:<場所> をカンマで区切る。
# 場所は Mackerel のメトリック名（temperature.<場所>）と D1 の location に入るので、英小文字、数字、_、- だけにする。
# deviceId は SwitchBot API の GET /v1.1/devices が返す deviceId
SWITCHBOT_DEVICES=XXXXXXXXXXXX:living,XXXXXXXXXXXX:room,XXXXXXXXXXXX:balcony

# アカウントが複数あるときだけ指定する
# CLOUDFLARE_ACCOUNT_ID=
